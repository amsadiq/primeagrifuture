rules_version = '2';
// ============================================================
//  Firestore security rules for the Prime AgriFuture portal
//  Paste these in: Firebase Console → Firestore Database → Rules → Publish
//
//  Policy: only SIGNED-IN users (your partners & founders, whose accounts
//  you create under Authentication → Users) can read or write farm records.
//  The public website cannot touch this data. This covers every collection
//  the portal uses — goats, cattle, crops, transactions, feed, births,
//  activities — and any added later.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
