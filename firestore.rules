rules_version = '2';
// ============================================================
//  Firestore security rules for the Prime AgriFuture portal
//  Paste these in: Firebase Console → Firestore Database → Rules → Publish
//
//  Policy: only SIGNED-IN users (your partners & founders, whose
//  accounts you create under Authentication → Users) can read or
//  write farm records. The public website cannot touch this data.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Farm operational collections
    match /livestock/{id}   { allow read, write: if request.auth != null; }
    match /feed/{id}        { allow read, write: if request.auth != null; }
    match /births/{id}      { allow read, write: if request.auth != null; }
    match /activities/{id}  { allow read, write: if request.auth != null; }

    // Everything else is denied by default
    match /{document=**} { allow read, write: if false; }
  }
}
